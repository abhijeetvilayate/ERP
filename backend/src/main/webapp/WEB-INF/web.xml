<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee 
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>College ERP System Backend</display-name>

    <!-- Welcome File List -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- Session Configuration (Timeout in minutes) -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

    <!-- Global CORS Filter Configuration -->
    <filter>
        <filter-name>CORSFilter</filter-name>
        <filter-class>com.collegeerp.config.CORSFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>CORSFilter</filter-name>
        <url-pattern>/*</url-pattern>
    </filter-mapping>

    <!-- Servlet Declarations & Mappings -->

    <!-- Authentication Servlet (Login / Register) -->
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>com.collegeerp.controller.AuthServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/api/auth/*</url-pattern>
    </servlet-mapping>

    <!-- Attendance Servlet -->
    <servlet>
        <servlet-name>AttendanceServlet</servlet-name>
        <servlet-class>com.collegeerp.controller.AttendanceServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AttendanceServlet</servlet-name>
        <url-pattern>/api/attendance/*</url-pattern>
    </servlet-mapping>

    <!-- Assignment Servlet -->
    <servlet>
        <servlet-name>AssignmentServlet</servlet-name>
        <servlet-class>com.collegeerp.controller.AssignmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AssignmentServlet</servlet-name>
        <url-pattern>/api/assignments/*</url-pattern>
    </servlet-mapping>

    <!-- Fee Management Servlet -->
    <servlet>
        <servlet-name>FeeServlet</servlet-name>
        <servlet-class>com.collegeerp.controller.FeeServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>FeeServlet</servlet-name>
        <url-pattern>/api/fees/*</url-pattern>
    </servlet-mapping>

    <!-- Library Operations Servlet -->
    <servlet>
        <servlet-name>LibraryServlet</servlet-name>
        <servlet-class>com.collegeerp.controller.LibraryServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LibraryServlet</servlet-name>
        <url-pattern>/api/library/*</url-pattern>
    </servlet-mapping>

</web-app>